# Copy to .env.local and fill in. Never commit real values.

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

GOOGLE_CLIENT_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379

# Production only
# DATABASE_URL=

# Optional, defaults to ./dev.sqlite
# SQLITE_DB_PATH=

# Optional free practice for guests, counted per IP address in Redis. Defaults shown.
# GUEST_SESSIONS_LIMIT=2
# GUEST_EVALUATIONS_LIMIT=20
# GUEST_WINDOW_DAYS=30
